# 运行时产物
server.log
server.log.*
nohup.out
# 运行期数据库：含管理员口令哈希与连接配置，属于本机数据，不进版本库。
# 首次启动由 init_db() 自动建表并写入 DEFAULT_CONFIG，克隆后无需手工准备。
2RTKserver.db
*.db.bak
*.db.bak*
*.db.temp
*.db-wal
*.db-shm
.secret_key

# Python
__pycache__/
*.py[cod]
venv/
.venv/

# 编辑器 / 系统
.DS_Store
.idea/
.vscode/

# 本地工作区数据（智能体日志、笔记等），不属于项目源码
.workbuddy/
# 安装版本信息与升级工作目录（备份、暂存、状态、日志），属于设备本地状态
.version
.upgrade/
